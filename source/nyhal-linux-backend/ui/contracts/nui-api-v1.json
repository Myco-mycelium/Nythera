{
  "registryVersion": "1.0",
  "nuiSchemaVersion": "0.4.0",
  "purpose": "The Nyrqis API Registry — the single machine-readable source of truth for the NUI component vocabulary, per NFS-006 (Nyforge) / the platform ADR-0025 pipeline. The Nyrqis NUI import gate (ui/nstudio.py, rust/nyui) and Nyforge's palette/Inspector/Behaviors contract tables all derive from this file. Add a component or action HERE first; never edit a consumer's tables by hand. registryVersion majors on breaking contract changes, alongside the NUI schema version.",
  "components": [
    { "type": "Text", "category": "Basic", "properties": ["text", "visible"], "events": [], "actions": [] },
    { "type": "Icon", "category": "Basic", "properties": ["glyph", "visible"], "events": [], "actions": [] },
    { "type": "Image", "category": "Basic", "properties": ["source", "visible"], "events": [], "actions": [] },
    { "type": "Button", "category": "Basic", "properties": ["text", "icon", "enabled", "visible"], "events": ["clicked", "pressed", "released"], "actions": [] },
    { "type": "Link", "category": "Basic", "properties": ["text", "target", "enabled"], "events": ["clicked"], "actions": [] },
    { "type": "Input", "category": "Basic", "properties": ["value", "placeholder", "enabled"], "events": ["changed", "submitted"], "actions": [] },
    { "type": "PasswordField", "category": "Basic", "properties": ["value", "placeholder", "enabled"], "events": ["changed", "submitted"], "actions": [] },
    { "type": "Checkbox", "category": "Basic", "properties": ["checked", "label", "enabled"], "events": ["changed"], "actions": [] },
    { "type": "Radio", "category": "Basic", "properties": ["selected", "label", "group", "enabled"], "events": ["changed"], "actions": [] },
    { "type": "Toggle", "category": "Basic", "properties": ["value", "label", "enabled"], "events": ["changed"], "actions": [] },
    { "type": "Slider", "category": "Basic", "properties": ["value", "min", "max", "enabled"], "events": ["changed"], "actions": [] },
    { "type": "ProgressBar", "category": "Basic", "properties": ["value", "min", "max"], "events": [], "actions": [] },
    { "type": "Container", "category": "Layout", "properties": ["padding", "background"], "events": [], "actions": [] },
    { "type": "Stack", "category": "Layout", "properties": ["orientation", "spacing"], "events": [], "actions": [] },
    { "type": "Grid", "category": "Layout", "properties": ["columns", "rows", "spacing"], "events": [], "actions": [] },
    { "type": "FlexLayout", "category": "Layout", "properties": ["direction", "wrap", "gap"], "events": [], "actions": [] },
    { "type": "SplitView", "category": "Layout", "properties": ["orientation", "splitRatio"], "events": [], "actions": [] },
    { "type": "ScrollView", "category": "Layout", "properties": ["direction"], "events": [], "actions": [] },
    { "type": "Card", "category": "Layout", "properties": ["elevation", "padding"], "events": [], "actions": [] },
    { "type": "Panel", "category": "Layout", "properties": ["background", "padding"], "events": [], "actions": [] },
    { "type": "Toolbar", "category": "Layout", "properties": ["background"], "events": [], "actions": [] },
    { "type": "StatusBar", "category": "Layout", "properties": ["background"], "events": [], "actions": [] },
    { "type": "Window", "category": "System", "properties": ["title", "resizable", "width", "height"], "events": ["opened", "closed"], "actions": ["Close"] },
    { "type": "Dialog", "category": "System", "properties": ["title", "modal"], "events": ["opened", "closed"], "actions": ["Open", "Close"] },
    { "type": "Notification", "category": "System", "properties": ["title", "message", "severity"], "events": ["dismissed"], "actions": ["Dismiss"] },
    { "type": "Sidebar", "category": "Navigation", "properties": ["width", "collapsible"], "events": [], "actions": ["Toggle"] },
    { "type": "NavigationRail", "category": "Navigation", "properties": ["collapsible"], "events": [], "actions": ["Toggle"] },
    { "type": "Tabs", "category": "Navigation", "properties": ["selectedIndex"], "events": ["changed"], "actions": ["SetSelectedIndex"] },
    { "type": "Breadcrumbs", "category": "Navigation", "properties": ["items"], "events": ["itemClicked"], "actions": [] }
  ],
  "systemActions": [
    { "name": "Nyrqis.Theme.Set", "arguments": ["theme"] },
    { "name": "Nyrqis.Settings.Commit", "arguments": [] },
    { "name": "Nyrqis.Window.Close", "arguments": ["windowId"] },
    { "name": "Nyrqis.Dialog.Open", "arguments": ["dialogId"] },
    { "name": "Nyrqis.Dialog.Close", "arguments": ["dialogId"] },
    { "name": "Nyrqis.Notification.Show", "arguments": ["title", "message", "severity"] }
  ]
