  },
  "components": [],
  "states": {
    "doNotDisturb": false,
    "lastRefresh": "12:04",
    "themeName": "Eclipse"
  },
  "behaviors": [
    {
      "id": "behavior_dnd_on",
      "condition": {
        "state": "doNotDisturb",
        "operator": "equals",
        "value": true
      },
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Do not disturb enabled",
          "message": "Notifications paused until disabled",
          "severity": "info"
        }
      }
    },
    {
      "id": "behavior_refresh",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Workspace refreshed",
          "message": "$state:lastRefresh",
          "severity": "info"
        }
      }
    },
    {
      "id": "behavior_theme_solar",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Theme.Set",
        "arguments": {
          "theme": "Solar"
        }
      }
    },
    {
      "id": "behavior_theme_eclipse",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Theme.Set",
        "arguments": {
          "theme": "Eclipse"
        }
      }
    },
    {
      "id": "behavior_about",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Nyrqis Shell",
          "message": "v0.1.0 — designed in NyForge",
          "severity": "info"
        }
      }
    }
  ],
  "bindings": [
    {
      "component": "toggle_dnd",
      "property": "value",
      "state": "doNotDisturb"
    }
  ],
