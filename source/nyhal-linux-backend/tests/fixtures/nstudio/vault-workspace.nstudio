  },
  "components": [],
  "states": {
    "autoSnapshot": true,
    "lastSync": "22:41",
    "posture": "guarded"
  },
  "behaviors": [
    {
      "id": "behavior_sync_now",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Vault synced",
          "message": "$state:lastSync",
          "severity": "info"
        }
      }
    },
    {
      "id": "behavior_snapshot_off",
      "condition": {
        "state": "autoSnapshot",
        "operator": "equals",
        "value": false
      },
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Auto-snapshot paused",
          "message": "Snapshot on demand only",
          "severity": "warning"
        }
      }
    },
    {
      "id": "behavior_new_volume",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "New volume",
          "message": "Volume creation wizard opened",
          "severity": "info"
        }
      }
    },
    {
      "id": "behavior_snapshot_now",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Snapshot taken",
          "message": "assets@2026-08-16-22:41",
          "severity": "info"
        }
      }
    }
  ],
  "bindings": [
    {
      "component": "toggle_auto",
      "property": "value",
      "state": "autoSnapshot"
    }
  ],
