    "updated": "2026-08-16T00:00:00+00:00"
  },
  "themes": {
    "active": "Eclipse",
    "overrides": {}
  },
  "components": [],
  "states": {
    "lockdown": false,
    "lastCheck": "22:09",
    "posture": "guarded"
  },
  "behaviors": [
    {
      "id": "behavior_lockdown_on",
      "condition": {
        "state": "lockdown",
        "operator": "equals",
        "value": true
      },
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Lockdown enabled",
          "message": "Container spawns paused until lifted",
          "severity": "warning"
        }
      }
    },
        {
      "id": "behavior_run_check",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Security posture check",
          "message": "$state:lastCheck",
          "severity": "info"
        }
      }
    },
    {
      "id": "behavior_export_audit",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Audit log export",
          "message": "Export queued — 1,204 events",
          "severity": "info"
        }
      }
    },
    {
      "id": "behavior_lockdown_btn",
      "condition": null,
      "action": {
        "target": "System",
        "name": "Nyrqis.Notification.Show",
        "arguments": {
          "title": "Lockdown requested",
          "message": "Confirm in the posture dialog",
          "severity": "warning"
        }
      }
    }
  ],
  "bindings": [
    {
      "component": "toggle_lockdown",
      "property": "value",
      "state": "lockdown"
    }
  ],
