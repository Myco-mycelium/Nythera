#!/usr/bin/env bash
# nyrqis-demo — the live image's console session for the `demo` user.
#
# 1. greets with quickstart instructions,
# 2. starts the backend daemon (as the demo user, unprivileged — the
#    backend's design posture: user namespaces, no root),
# 3. attempts the desktop session (nyrqis_init) and reports honestly if
#    the hardware/software can't present,
# 4. probes the machine for the demo-relevant capabilities and prints
#    exactly what is MISSING — the "see what is missing" ask.
#
# Everything here degrades honestly; the banner is the product.
set -u

# Marks the demo session so a nested login shell (bash -l typed by the
# user) does not exec the demo again — .bash_profile checks this.
export NYRQIS_DEMO_ACTIVE=1

OPT=/opt/nyrqis/nyhal-linux-backend
BACKEND="$OPT/nyrqis_backend.py"
CTL="$OPT/nyrqisctl.py"
SOCK=/tmp/nyrqis-status.sock
LOG=/tmp/nyrqis-daemon.log
# Rust cdylibs install location (the build keeps compiled artifacts in
# rust/.cdylibs). Exported so every loader's bare-name fallback via
# LD_LIBRARY_PATH finds them without a wrapper wrapper per module.
export NYRQIS_CDYLIB_DIR="$OPT/rust/.cdylibs"
if [ -d "$NYRQIS_CDYLIB_DIR" ]; then
    # ${LD_LIBRARY_PATH:-}: set -u safe — an unset LD_LIBRARY_PATH is the
    # NORMAL case (a bare boot), and an unguarded expansion here killed
    # the demo session in a getty respawn loop on the first image that
    # actually shipped cdylibs (the branch never ran in CI without them).
    case ":${LD_LIBRARY_PATH:-}" in
        *":$NYRQIS_CDYLIB_DIR:"*) : ;;
        *) export LD_LIBRARY_PATH="$NYRQIS_CDYLIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
    esac
fi

G=$'\e[1;32m'; B=$'\e[1;34m'; Y=$'\e[1;33m'; R=$'\e[1;31m'; D=$'\e[2m'; N=$'\e[0m'

have() { command -v "$1" >/dev/null 2>&1; }

section() { printf '\n%s== %s ==%s\n' "$B" "$*" "$N"; }
ok()      { printf '  %s✓%s %s\n' "$G" "$N" "$*"; }
warn()    { printf '  %s•%s %s\n' "$Y" "$N" "$*"; }
missing() { printf '  %s✗ MISSING:%s %s\n' "$R" "$N" "$*"; }

# FFI marker for the boot-smoke serial log: counts the shipped Rust
# cdylibs and how many load through ctypes. Informational (crates are
# optional at runtime with honest stub fallbacks), but a sudden 0
# explains a degraded boot at a glance.
crate_marker() {
    local shipped loaded so
    shipped=$(ls "$NYRQIS_CDYLIB_DIR"/libnyrqis_*.so 2>/dev/null | wc -l)
    loaded=0
    if [ "$shipped" -gt 0 ]; then
        for so in "$NYRQIS_CDYLIB_DIR"/libnyrqis_*.so; do
            python3 -c "import ctypes,sys; ctypes.CDLL(sys.argv[1])" \
                "$so" >/dev/null 2>&1 && loaded=$((loaded+1))
        done
    fi
    echo "NYRQIS_BOOT_SMOKE_CRATE=$loaded/$shipped"
}

# Package-parity marker for the boot-smoke drivers: the probe's
# REQUIRED package class — the components whose absence it reports as
# ✗ MISSING (hardware items like DRM nodes are machine-dependent and
# honestly reported, never image defects). A booted image whose first
# screen would print MISSING must fail the CI smoke, not merely look
# sad in a human session — this marker is what the drivers assert.
pkg_marker() {
    local gaps=""
    have python3                     || gaps="$gaps python3"
    python3 -c "import zstandard" 2>/dev/null || gaps="$gaps python3-zstandard"
    python3 -c "import nacl" 2>/dev/null      || gaps="$gaps python3-nacl"
    have fusermount3                 || gaps="$gaps fusermount3"
    if [ -z "$gaps" ]; then
        echo "NYRQIS_BOOT_SMOKE_PKGS=ok"
    else
        echo "NYRQIS_BOOT_SMOKE_PKGS=missing$gaps"
    fi
}

# The capability probe, as a function so --probe-only can run it on any
# machine (no boot required).
probe() {
    section "Capability probe — what this machine is missing"
    have systemctl   && ok "systemd present"                  || missing "systemd (live-boot session management degraded)"
    have python3     && ok "python3 present"                  || missing "python3 (backend cannot run)"
    [[ -d /sys/class/drm ]] && ok "kernel DRM subsystem"      || missing "kernel DRM (/sys/class/dri) — no GPU presentation path"
    ls /dev/dri/card* >/dev/null 2>&1 && ok "DRM render node(s): $(ls /dev/dri/ | tr '\n' ' ')" \
                                                     || missing "/dev/dri nodes — no KMS driver bound (VMs: add virtio-gpu)"
    have fusermount3 && ok "FUSE 3 (NyFS mounts possible)"    || missing "fusermount3 — NyFS vault mounts disabled"
    have qemu-img    && ok "qemu-img (disk images)"           || :
    [[ -e /dev/kvm ]] && ok "KVM (container accel)"           || warn "/dev/kvm absent — fine, containers use user namespaces"
    sysctl -n kernel.unprivileged_userns_clone 2>/dev/null | grep -q 1 \
        && ok "unprivileged user namespaces enabled"          || warn "user namespaces may be restricted (containers: check sysctl kernel.unprivileged_userns_clone)"
    have zstd && ok "zstd tooling"                            || warn "zstd CLI absent (library support is what the backend uses)"
    python3 -c "import zstandard" 2>/dev/null && ok "zstandard python module" \
                                                              || missing "python zstandard module — compression falls back to stored blocks"
    python3 -c "import nacl"       2>/dev/null && ok "PyNaCl (package signing)" \
                                                              || missing "PyNaCl — package signing/verification refuses to run (fail-closed)"
    python3 -c "import lz4.frame"  2>/dev/null && ok "lz4 fast path" \
                                                              || warn "python lz4 module absent — LZ4 fast-path override unavailable"
    [[ -d "$OPT/rust/ipc/target/release" ]] && ok "Rust IPC crate prebuilt" \
                                                              || warn "Rust serving-loop crate absent — Python floor serves (slower, same behavior)"
    have nyrqisctl  && ok "nyrqisctl on PATH"                 || warn "nyrqisctl not on PATH — use: python3 $CTL"
    # Boot-smoke handshake markers (the CI driver greps the serial log).
    [[ -f /tmp/nyrqis-boot-smoke-ready ]] && ok "boot smoke: ready marker seen" \
                                              || :  # marker absent outside the smoke entry
    have nyrqis-backend && ok "entry points installed"        || warn "entry points not installed — scripts run from $OPT directly"
}

# Headless/serial boot smoke: when the kernel command line carries
# NYRQIS_BOOT_SMOKE=1, start the daemon, write the ready marker, and let
# the smoke driver assert on the serial log; no interactive session.
# The ping polls for up to 30 s (TCG-slowed runners boot far slower than
# a fixed sleep can guess) and never aborts early — READY must land even
# when the daemon fails, so the driver's diagnosis is reliable.
start_daemon() {
    # Singleton daemon: both autologin consoles (the GUI getty + the
    # arch's serial getty) exec this script and can reach the daemon
    # section nearly simultaneously —
    # flock decides one winner; the loser returns immediately and then
    # ADOPTS the winner's daemon via the ping that follows (a second
    # daemon on the same socket dies with EADDRINUSE and its failure is
    # what readers of the log would see — CI round 18 exactly). The lock
    # fd is inherited by the daemon, so it is held for the daemon's
    # lifetime; a crashed daemon releases it and the next session takes
    # over. Also removes a bound-but-unlistened stale socket, which
    # would otherwise EADDRINUSE forever.
    (
        flock -n 9 || exit 0
        rm -f "$SOCK"
        exec python3 "$BACKEND" service serve --socket "$SOCK" \
            --state-file /tmp/nyrqis-daemon-state.json \
            --vault-dir /tmp/nyrqis-vault \
            >>"$LOG" 2>&1
    ) 9>/tmp/nyrqis-daemon.lock &
}

# The two autologin consoles (GUI getty + the arch's serial getty) both
# exec this script:
# whoever wins starts the daemon, the loser must ADOPT it instead of
# racing a second daemon for the same socket (the EADDRINUSE loser's
# PONG=0 is what a reader of the log would see — CI round 18 exactly).
wait_for_daemon() {
    local i
    for i in $(seq 1 15); do
        python3 "$CTL" --socket "$SOCK" ping >/dev/null 2>&1 && return 0
        sleep 1
    done
    return 1
}

if grep -q 'NYRQIS_BOOT_SMOKE=1' /proc/cmdline 2>/dev/null; then
    # Only the SERIAL session runs the smoke handshake: the driver
    # reads the serial line, and the other console's VGA output is
    # invisible to it. The serial console is ARCH-SPECIFIC — ttyS0 on
    # x86, ttyAMA0 on arm64 (QEMU 'virt' and most SBCs) — so both are
    # matched here; /dev/console covers the ttyS0=console handoff case.
    # The other console waits for the shared daemon instead of racing a
    # second one for the same socket (EADDRINUSE loser's PONG=0 — CI
    # round 18). Matching ONLY ttyS0 here (the original form) hung the
    # arm64 smoke forever: its serial session fell into the * branch and
    # parked on `sleep infinity` before printing any marker.
    case "$(tty 2>/dev/null)" in
        /dev/ttyS0|/dev/ttyAMA0|/dev/console) : ;;
        *)
            if ! wait_for_daemon; then start_daemon; wait_for_daemon; fi
            exec sleep infinity
            ;;
    esac
    echo "== nyrqis boot smoke =="
    if ! wait_for_daemon; then
        start_daemon
    fi
    pong=0
    for _ in $(seq 1 30); do
        if python3 "$CTL" --socket "$SOCK" ping >/dev/null 2>&1; then
            pong=1
            break
        fi
        sleep 1
    done
    if [ "$pong" = 1 ]; then
        echo "NYRQIS_BOOT_SMOKE_PONG=1"
    else
        echo "NYRQIS_BOOT_SMOKE_PONG=0"
        tail -5 "$LOG" 2>/dev/null
    fi
    # Entry-point wrappers on PATH (the build writes them): proves the
    # installed-system commands exist in the image, visible in the
    # boot-smoke serial log.
    if command -v nyrqisctl >/dev/null 2>&1 \
       && command -v nyrqis-backend >/dev/null 2>&1; then
        echo "NYRQIS_BOOT_SMOKE_NYRQISCTL=1"
    else
        echo "NYRQIS_BOOT_SMOKE_NYRQISCTL=0"
    fi
    # BEFORE the ready marker (drivers may stop reading at READY): the
    # probe's required-package class must be complete in the image.
    pkg_marker
    # FFI honesty marker: report how many Rust cdylibs shipped and
    # actually dlopen. Optional at runtime (honest fallbacks), so this
    # is INFORMATIONAL — never a pass/fail gate (a crate that fails to
    # load degrades to the stub path by design).
    crate_marker
    echo "NYRQIS_BOOT_SMOKE_READY=1"
    exec sleep infinity
fi

# Probe-only mode: the "what is missing" report on any machine, no boot
# required. Prints just the capability probe and exits 1 if anything
# read as MISSING (grep for '✗ MISSING:').
if [[ "${1:-}" == "--probe-only" ]]; then
    out=$(probe 2>&1)
    printf '%s\n' "$out"
    grep -q $'✗' <<<"$out" && exit 1
    exit 0
fi

clear
cat <<BANNER
${G}
  ███╗   ██╗██╗   ██╗██████╗  ██████╗ ██╗███████╗
  ████╗  ██║╚██╗ ██╔╝██╔══██╗██╔═══██╗██║██╔════╝
  ██╔██╗ ██║ ╚████╔╝ ██████╔╝██║   ██║██║███████╗
  ██║╚██╗██║  ╚██╔╝  ██╔══██╗██║   ██║██║╚════██║
  ██║ ╚████║   ██║   ██║  ██║╚██████╔╝██║███████║
  ╚═╝  ╚═══╝   ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚═╝╚══════╝${N}
     Nexus for Your Resilient Quantum-ready Integrated System
        live demo — navigate, explore, report gaps

  Quickstart
    ${B}ep-limits${N}   operator IPC limiter commands (try: ep-limits list)
    ${B}containers${N}  spawn/kill capability-scoped containers
    ${B}vault${N}       NyVault storage volumes
    ${B}status${N}      daemon status / health

  This banner reruns anytime with:  ${B}nyrqis-demo${N}
BANNER

# ---------------------------------------------------------------- daemon
section "Backend daemon"
if [[ ! -f "$BACKEND" ]]; then
    missing "backend tree at $OPT — the image build failed to install it"
elif python3 "$CTL" --socket "$SOCK" ping >/dev/null 2>&1; then
    # The OTHER autologin console already started the daemon: adopt it,
    # never race a second one for the same socket.
    ok "daemon already serving on $SOCK (adopted)"
else
    start_daemon
    if wait_for_daemon; then
        ok "daemon serving on $SOCK (log: $LOG)"
        python3 "$CTL" --socket "$SOCK" ep-limits list 2>/dev/null | sed 's/^/    /'
    else
        missing "daemon did not come up — see $LOG"
        tail -5 "$LOG" 2>/dev/null | sed 's/^/      /'
    fi
fi

# ---------------------------------------------------------------- desktop
section "Desktop session"
if [[ ! -f "$OPT/nyrqis_init.py" ]]; then
    missing "desktop tree (nyrqis_init.py not present)"
else
    # Best effort: present only if a DRM master can be taken; the
    # backend fails closed otherwise (software fallback stores frames
    # for inspection instead of scanout).
    if python3 "$OPT/ui/drm_backend.py" probe >/dev/null 2>&1 \
       || [[ -w /dev/dri/card0 ]] || [[ -w /dev/dri/card1 ]]; then
        ok "DRM device available — attempting the desktop session"
        # Boot-menu variant selection: `nyrqis.variant=pill` on the
        # kernel cmdline (GRUB/isolinux "pill shell" entry) selects the
        # shell variant for this boot; --design still wins.
        variant=""
        for word in $(cat /proc/cmdline); do
            case "$word" in
                nyrqis.variant=*) variant="${word#nyrqis.variant=}" ;;
            esac
        done
        case "$variant" in
            "") : ;;
            stock) : ;;
            *) export NYRQIS_SHELL_VARIANT="$variant"
               ok "shell variant: $variant (kernel cmdline)" ;;
        esac
        (cd "$OPT" && timeout 8 python3 nyrqis_init.py >/tmp/nyrqis-desktop.log 2>&1) \
            && ok "desktop session started (log: /tmp/nyrqis-desktop.log)" \
            || warn "desktop did not stay up (expected on some VMs) — see /tmp/nyrqis-desktop.log"
    else
        warn "no usable DRM device — the compositor will fall back to software frames"
        warn "desktop autostart skipped; try:  cd $OPT && python3 nyrqis_init.py"
    fi
fi

# ---------------------------------------------------------------- probe
probe
# The drivers' package-parity evidence, in the interactive log too (the
# menu boot smoke greps the same serial stream).
pkg_marker

section "Try this"
cat <<TRY
    python3 $CTL --socket $SOCK ep-limits list
    python3 $CTL --socket $SOCK ep-limits metrics --watch 1
    python3 $CTL --socket $SOCK containers list
    python3 $CTL --socket $SOCK vault status
    cd $OPT && python3 -m unittest test_backend.TestOperatorCli -v
TRY

printf '\n%sThe demo is yours — everything above degrades honestly; what printed%s\n' "$D" "$N"
printf '%sMISSING is exactly what the next release needs on this hardware.%s\n\n' "$D" "$N"
# Hand off to a shell WITHOUT re-entering the demo: .bash_profile execs
# this script, so spawning any login shell here (bash -l) would re-run
# the profile → re-exec this script → an infinite banner loop that never
# yields a shell (the "boots but floods the console" failure). Two cases:
#   * interactive ($- has i): a human ran nyrqis-demo from a shell — a
#     plain exec bash is a non-login shell, profile never re-read.
#   * non-interactive (exec'd from .bash_profile at autologin): exec an
#     INTERACTIVE shell with --noprofile so the profile — and therefore
#     this script — cannot run again. Exiting instead would make agetty
#     re-autologin and respawn the banner forever.
case $- in
    *i*) exec bash ;;
    *)   exec bash --noprofile -i ;;
esac
