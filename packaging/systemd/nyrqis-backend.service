# Nyrqis Linux Backend — systemd host integration (implementation_plan.md §4.5)
#
# Runs the backend's status-service daemon as a boot service. The daemon
# owns the IPC registry + capability manager + container manager, serves
# the container-facing status service, and accepts operator control
# commands over the same Unix-domain datagram transport
# (nyrqis_backend.py control ...).
#
# Install (see packaging/README.md):
#   sudo cp packaging/systemd/nyrqis-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nyrqis-backend
#
# The backend is a reference implementation that launches containers via
# unprivileged user namespaces (no root required); the unit therefore
# deliberately runs unprivileged under its own runtime directory rather
# than as root.
#
# Logging + state (plan 4.5): --syslog mirrors daemon records into the
# journal via /dev/log (systemd owns that socket), and --state-file
# keeps the crash-recovery record inside the RuntimeDirectory, which
# systemd creates (and chowns to the service user) — so the daemon can
# always write it.
#
# Health probe (ADR-0021): --health-socket serves ping on a dedicated
# path via the Rust serving loop when the crate is present (the Python
# floor otherwise — byte-identical replies). Operators or a systemd
# HealthCheckCommand can probe liveness without touching the
# container-facing service socket.
#
# NyVault (ADR-0022/0023): the volume backing store lives in the
# StateDirectory (/var/lib/nyrqis, created and chowned to the service
# user by systemd) so volumes + the registry + wrapped DEKs survive
# restarts. At-rest encryption activates when the operator has placed a
# KEK envelope at /var/lib/nyrqis/vault.key (`nyrqisctl vault init
# /var/lib/nyrqis/vault.key --passphrase ...`; the envelope is NOT a
# secret — chmod 0644 is fine) AND the unlock passphrase is present in
# the optional EnvironmentFile. Until then the vault runs plaintext
# (the crate-less fallback). The EnvironmentFile is optional (the `-`
# prefix): with no file the unit is still valid, the daemon just serves
# an unencrypted vault.
#
#   sudo mkdir -p /etc/nyrqis && sudo chmod 0700 /etc/nyrqis
#   echo 'NYRQIS_VAULT_PASSPHRASE=change-me' | sudo tee /etc/nyrqis/backend.env >/dev/null
#   sudo chmod 0600 /etc/nyrqis/backend.env

[Unit]
Description=Nyrqis Linux backend daemon (status service + control plane)
Documentation=https://github.com/Myco-mycelium/Nythera/blob/main/docs/implementation_plan.md
After=network.target
Wants=network.target

[Service]
Type=simple
# The backend CLI lives beside the source tree in this repository;
# adjust ExecStart for a packaged install (see README.md). The CLI
# resolves its own directory, so only the ExecStart path matters here.
ExecStart=/usr/bin/python3 /opt/nyrqis/nyhal-linux-backend/nyrqis_backend.py service serve --socket /run/nyrqis/status.sock --health-socket /run/nyrqis/health.sock --syslog --state-file /run/nyrqis/daemon-state.json --vault-dir /var/lib/nyrqis/vault --vault-key-file /var/lib/nyrqis/vault.key
Restart=on-failure
RestartSec=2

# Runtime directory: created (and chowned to the service user) by
# systemd itself, removed when the service stops — no ExecStartPre
# mkdir needed.
RuntimeDirectory=nyrqis
RuntimeDirectoryMode=0755

# State directory: created (and chowned to the service user) by
# systemd, PERSISTS across restarts — the NyVault backing store, the
# volume registry, and the KEK envelope live here.
StateDirectory=nyrqis
StateDirectoryMode=0750

# Optional vault unlock secret: read from /etc/nyrqis/backend.env if it
# exists (the `-` prefix). Without it the vault serves plaintext.
EnvironmentFile=-/etc/nyrqis/backend.env

# Hardening (best-effort — the backend must still create user
# namespaces and cgroups for containers, so full namespace/priv
# sandboxing is deliberately NOT applied here).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# ProtectSystem=full does NOT cover /opt, so pin the install tree
# read-only explicitly. Writable locations for the daemon must live
# under /run/nyrqis (the RuntimeDirectory) — do not place a NyFS
# image store or journal under /opt/nyrqis.
ReadOnlyPaths=/opt/nyrqis

# The daemon and its containers communicate over Unix datagram sockets
# under the runtime directory; give the service its own user for a
# baseline privilege separation (adjust if your distribution needs
# DynamicUser off).
DynamicUser=true

[Install]
WantedBy=multi-user.target
