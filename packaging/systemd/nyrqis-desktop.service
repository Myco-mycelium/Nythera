# Nyrqis Desktop Session — systemd host integration.
#
# Runs the desktop session (nyrqis_init's session stage) as a SYSTEM
# service after the backend daemon. NOTE: `graphical-session.target` is
# a USER-session target (it lives in the user manager, started per
# graphical login); a SYSTEM unit cannot Require/Want it — verify fails
# with "Unit graphical-session.target not found" on real hosts. The
# system-level hook for a graphical boot is `graphical.target`.
#
# Install (see packaging/README.md):
#   sudo cp packaging/systemd/nyrqis-desktop.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable nyrqis-desktop
#
# The session is per-user in spirit (%h = the service user's home); with
# DynamicUser the home is ephemeral, so a real desktop host should set
# User= to a dedicated user whose ~/.nyrqis/shell.nstudio exists
# (install.sh --user seeds it for the invoking user).

[Unit]
Description=Nyrqis Desktop Session
Documentation=https://github.com/Myco-mycelium/Nythera
After=nyrqis-backend.service graphical.target
Wants=nyrqis-backend.service graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m nyrqis_session %h/.nyrqis/shell.nstudio
Restart=on-failure
RestartSec=3

# Desktop-specific environment
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=graphical.target
